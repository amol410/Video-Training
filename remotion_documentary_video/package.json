{
  "name": "remotion-documentary-video",
  "version": "1.0.0",
  "description": "Documentary Video in Remotion: Jensen Huang & The AI Revolution",
  "scripts": {
    "start": "remotion preview",
    "build": "remotion render src/index.ts MainVideo out/documentary_master.mp4",
    "render": "remotion render src/index.ts MainVideo out/documentary_master.mp4 --codec=h264",
    "render:fast": "remotion render src/index.ts MainVideo out/documentary_master.mp4 --codec=h264-videotoolbox",
    "still": "remotion still src/index.ts MainVideo out/thumbnail.png --frame=60"
  },
  "dependencies": {
    "@remotion/cli": "^4.0.218",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "remotion": "^4.0.218"
  },
  "devDependencies": {
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.1",
    "typescript": "^5.4.5"
  }
}
